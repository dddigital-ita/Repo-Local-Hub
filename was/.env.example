[TEMPLATE]
# ── Sito (WEB AGENCY SALENTO) ─────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://www.webagencysalento.com   # dominio canonico (SEO); was.dddigital.net fa redirect 308 qui (vercel.json)
NEXT_PUBLIC_AGENCY_NAME=Web Agency Salento
NEXT_PUBLIC_AGENCY_PHONE=+393200865907                   # Daniele — telefono principale
NEXT_PUBLIC_AGENCY_EMAIL=info@webagencysalento.com       # DA CONFERMARE
NEXT_PUBLIC_AGENCY_VAT=P.IVA 00000000000                 # DA FORNIRE
NEXT_PUBLIC_AGENCY_ADDRESS="Via Example 1, 73100 Lecce (LE)"   # DA FORNIRE
NEXT_PUBLIC_AGENCY_LEGAL_NAME="Web Agency Salento"       # DA CONFERMARE forma societaria
NEXT_PUBLIC_SEARCH_GSC_TOKEN=          # opzionale: contenuti del file googleXXXX.html

# ── Neon (Postgres) ──────────────────────────────────────────
# console.neon.com → progetto NUOVO per il Salento (mai condiviso con Crema)
DATABASE_URL=postgresql://user:pass@ep-xxx.eu-central-2.aws.neon.tech/neondb?sslmode=require
# Segreto per la firma dei cookie sessione admin
ADMIN_SESSION_SECRET=stringa-lunga-a-caso

# ── Resend (email notifiche) ─────────────────────────────────
RESEND_API_KEY=re_...
NOTIFY_EMAIL=operazioni@DOMINIO.IT     # destinatario notifiche
EMAIL_FROM="Web Agency Salento <noreply@DOMINIO.IT>"   # dominio verificato su Resend

# ── Notifiche Telegram (opzionale ma consigliato) ────────────
TELEGRAM_BOT_TOKEN=                    # da @BotFather (bot NUOVO per il Salento)
TELEGRAM_CHAT_ID=                      # chat id dell'operatore/gruppo

# ── Google kit (proprietà NUOVE per il dominio Salento) ─────
NEXT_PUBLIC_GA4_ID=G-XXXXXXXXXX
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX
# Microsoft Clarity (opzionale, Fase 3)
NEXT_PUBLIC_CLARITY_ID=

# ── Team vero: nome,telefono,inizioTurno,fineTurno[,whatsapp] ──
# OPERATOR_A=Daniele,+393200865907,9,14
# OPERATOR_B=SECONDO-OPERATORE-DA-DEFINIRE,+39XXXXXXXXX,14,19
# Foto profilo opzionali: public/team/a.jpg e public/team/b.jpg

# ── Admin bootstrap (primo accesso, poi gestito da Supabase Auth) ──
ADMIN_EMAILS=info@DOMINIO.IT
ADMIN_BOOTSTRAP_PASSWORD=              # password provvisoria del primo utente

# ── Backup cloud giornaliero (Neon Object Storage, bucket «backups») ──
# Le credenziali del branch: Neon Console → progetto → branch → Storage
# (o `npx neonctl api …/credentials …/reveal`). Sempre le STESSE del branch
# di produzione: sono branch-scoped, mai condivise tra siti. Senza queste
# env il backup resta SPENTO (il tick salta con config_mancante) e dopo 2
# giorni l'allarme della rete di sicurezza suona.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=      # endpoint S3 del branch (…storage….aws.neon.tech)
AWS_REGION=eu-central-1

# ── Shield: captcha invisibile Cloudflare Turnstile (opzionale) ──
# Chiavi di test per lo sviluppo locale:
#   NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
#   TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# Chiavi vere: dash.cloudflare.com → Turnstile → Add site
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
