{
  "name": "crema-web-agency",
  "version": "0.9.1",
  "private": true,
  "scripts": {
    "admin:create": "node scripts/create-admin.mjs",
    "backup": "node scripts/backup-full.mjs",
    "build": "node scripts/overlay-guard.mjs --quiet && next build --webpack",
    "build:local": "node scripts/overlay-guard.mjs --quiet && WAC_DIST_DIR=.next-prod next build --webpack",
    "build:turbo": "node scripts/overlay-guard.mjs --quiet && WAC_DIST_DIR=.next-prod next build",
    "db:migrate": "node scripts/db-migrate-all.mjs",
    "setup:local": "node scripts/setup-localhost.mjs",
    "dev": "next dev --webpack",
    "start:passenger": "node server.js",
    "dev:turbo": "next dev --turbopack",
    "guard:overlays": "node scripts/overlay-guard.mjs",
    "lint": "eslint .",
    "postinstall": "git config core.hooksPath githooks 2>/dev/null || true",
    "start": "next start",
    "start:local": "WAC_DIST_DIR=.next-prod next start",
    "test": "node --test 'tests/*.test.mjs'",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1144.0",
    "@neon/config": "^1.7.2",
    "@neon/env": "^1.4.3",
    "@next/third-parties": "^16.3.6",
    "@phosphor-icons/react": "^2.1.10",
    "@tabler/icons-react": "^3.48.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.23.0",
    "frimousse": "^0.4.0",
    "imapflow": "^2.0.6",
    "lucide-react": "^0.545.0",
    "neon": "^5.0.1",
    "next": "^16.3.6",
    "nodemailer": "^10.0.10",
    "pg": "^8.23.0",
    "react": "^19.1.0",
    "resend": "^6.1.0",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.6",
    "postcss": "^8.4.49",
    "prettier": "^3.6.2",
    "tailwindcss": "^3.4.17",
    "typescript": "^5"
  }
}
