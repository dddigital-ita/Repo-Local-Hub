[TEMPLATE]
# ── Sito ─────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://www.DOMINIO.IT
NEXT_PUBLIC_AGENCY_NAME=NOME_AGENZIA
NEXT_PUBLIC_AGENCY_PHONE=+39TELEFONO
NEXT_PUBLIC_AGENCY_EMAIL=info@DOMINIO.IT
NEXT_PUBLIC_AGENCY_VAT=P.IVA 00000000000
NEXT_PUBLIC_AGENCY_ADDRESS="Via Example 1, 26013 Crema (CR)"
NEXT_PUBLIC_AGENCY_LEGAL_NAME="NOME_AGENZIA S.r.l."
NEXT_PUBLIC_SEARCH_GSC_TOKEN=          # opzionale: contenuti del file googleXXXX.html

# ── Neon (Postgres) ──────────────────────────────────────────
# console.neon.com → progetto → Connection string (pooled)
DATABASE_URL=postgresql://user:pass@ep-xxx.eu-central-2.aws.neon.tech/neondb?sslmode=require
# Segreto per la firma dei cookie sessione admin
ADMIN_SESSION_SECRET=stringa-lunga-a-caso

# ── Resend (email notifiche) ─────────────────────────────────
RESEND_API_KEY=re_...
NOTIFY_EMAIL=operazioni@DOMINIO.IT     # destinatario notifiche
EMAIL_FROM="NOME_AGENZIA <noreply@DOMINIO.IT>"   # dominio verificato su Resend

# ── Notifiche Telegram (opzionale ma consigliato) ────────────
TELEGRAM_BOT_TOKEN=                    # da @BotFather
TELEGRAM_CHAT_ID=                      # chat id dell'operatore/gruppo

# ── Canali social: OAuth Meta (Facebook + Instagram) ─────────
# Meta Developers → la tua app → Impostazioni di base
META_APP_ID=
META_APP_SECRET=
# ── OAuth LinkedIn (organizzazioni) ──────────────────────────
# LinkedIn Partner Portal → la tua app → Auth
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# Redirect URI da registrare in ENTRAMBE le app provider
# (stesso dominio del sito, esatto — compreso https://):
#   https://www.DOMINIO.IT/api/auth/meta/callback
#   https://www.DOMINIO.IT/api/auth/linkedin/callback

# ── Google kit ───────────────────────────────────────────────
NEXT_PUBLIC_GA4_ID=G-XXXXXXXXXX
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX
# Microsoft Clarity (opzionale, Fase 3)
NEXT_PUBLIC_CLARITY_ID=

# ── Team vero: nome,telefono,inizioTurno,fineTurno[,whatsapp] ──
# OPERATOR_A=Maria,+393331234567,9,13
# OPERATOR_B=Luca,+393337654321,15,19
# Foto profilo opzionali: public/team/a.jpg e public/team/b.jpg

# ── Admin bootstrap (primo accesso, poi gestito da Supabase Auth) ──
ADMIN_EMAILS=marco@DOMINIO.IT,giulia@DOMINIO.IT
ADMIN_BOOTSTRAP_PASSWORD=              # password provvisoria del primo utente

# ── Backup cloud giornaliero (Neon Object Storage, bucket «backups») ──
# Credenziali del branch di produzione (branch-scoped, mai condivise tra siti):
# Neon Console → branch → Storage, o reveal via API. Il bucket «backups» vive
# nel branch (neon.ts). Senza env il backup resta spento e l'allarme suona
# dopo 2 giorni di silenzio.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=
AWS_REGION=eu-central-1

# ── Shield: captcha invisibile Cloudflare Turnstile (opzionale) ──
# Chiavi di test per lo sviluppo locale:
#   NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
#   TURNSTILE_SECRET_KEY=1x000000000000000000000000000000AA
# Chiavi vere: dash.cloudflare.com → Turnstile → Add site
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
